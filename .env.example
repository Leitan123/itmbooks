# Database Configuration (MySQL)
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="itmbooks_db"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secrets (NextAuth)
NEXTAUTH_SECRET="generate_a_strong_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider (e.g. SMTP / Gmail)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS="your_smtp_password"
SMTP_FROM_EMAIL="ITM Books System <no-reply@itmbooks.com>"

# CyberSource
CYBERSOURCE_MERCHANT_ID=""
CYBERSOURCE_API_KEY_ID=""
CYBERSOURCE_API_SECRET_KEY=""

# Google OAuth Configuration
# Get credentials from Google Cloud Console: https://console.cloud.google.com/
# APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Web Application)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: 
#   - http://localhost:3000/itmbooks.com/api/auth/callback/google
#   - http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

