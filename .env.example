# Database Configuration (MySQL)
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="itmbooks_db"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secrets (NextAuth)
NEXTAUTH_SECRET="generate_a_strong_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider (e.g. SMTP / Gmail)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS="your_smtp_password"
SMTP_FROM_EMAIL="ITM Books System <no-reply@itmbooks.com>"

# CyberSource
CYBERSOURCE_MERCHANT_ID=""
CYBERSOURCE_API_KEY_ID=""
CYBERSOURCE_API_SECRET_KEY=""
